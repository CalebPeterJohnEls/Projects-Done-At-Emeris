@model Smart_X_Client.Models.Sensor

@*
    The sensor-registration form uses ASP.NET Core Tag Helpers to bind each
    input to the strongly typed Sensor model. The asp-for Tag Helper
    automatically generates the appropriate id and name attributes and
    supports model validation (Microsoft, 2026y).

    The form uses Bootstrap components, form controls and buttons to provide
    a consistent and responsive user interface (Bootstrap, 2026b;
    Bootstrap, 2026c).

    Strong typing allows the form data to correspond directly with the
    Sensor model and supports structured object-oriented programming
    principles (Nakov and Kolev et al., 2013; Troelsen and Japikse, 2022).

    HTML form elements are used to collect and submit structured sensor
    information (W3Schools, 2025b).
*@

@{
    ViewData["Title"] = "Register Sensor";
}

<style>
    /*
                Custom CSS is used to improve spacing, sizing, borders and the
                overall appearance of the registration form (W3Schools, 2025a).
            */

    .sensor-register-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    .sensor-form-card {
        width: 100%;
        max-width: 620px;
        background-color: #1f2226;
        border: 1px solid #343a40;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    }

    .sensor-form-title {
        text-align: center;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .sensor-form-subtitle {
        text-align: center;
        color: #adb5bd;
        margin-bottom: 25px;
        font-size: 0.95rem;
    }

    .sensor-form-card hr {
        border-color: #343a40;
        margin-bottom: 25px;
    }

    .sensor-form-group {
        margin-bottom: 18px;
    }

        .sensor-form-group label {
            display: block;
            margin-bottom: 7px;
            color: #f8f9fa;
        }

    .sensor-form-card .form-control,
    .sensor-form-card .form-select {
        background-color: #292d32;
        color: white;
        border: 1px solid #495057;
        border-radius: 8px;
        padding: 10px 12px;
    }

        .sensor-form-card .form-control:focus,
        .sensor-form-card .form-select:focus {
            background-color: #292d32;
            color: white;
            border-color: #4dabf7;
            box-shadow: 0 0 0 0.2rem rgba(77, 171, 247, 0.2);
        }

        .sensor-form-card .form-control::placeholder {
            color: #868e96;
        }

        .sensor-form-card .form-select option {
            background-color: #292d32;
            color: white;
        }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        font-size: 0.85rem;
    }

    .file-help {
        display: block;
        margin-top: 6px;
        color: #868e96;
        font-size: 0.8rem;
    }

    .register-btn {
        padding: 11px 20px;
        border-radius: 8px;
        font-weight: 600;
    }

    .back-btn {
        border-radius: 8px;
        padding: 8px 18px;
    }

    .form-actions {
        margin-top: 25px;
    }
</style>

<div class="sensor-register-page">

    <div class="sensor-form-card">

        <h1 class="sensor-form-title">
            Register Sensor
        </h1>

        <p class="sensor-form-subtitle">
            Enter the sensor information and attach any required
            configuration or log files.
        </p>

        <hr />

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @*
                The validation summary shows messages that are not tied to a
                single field, such as errors returned by the API
                (Microsoft, 2026y).
            *@
            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="sensor-form-group">

                <label asp-for="DeviceIdentifier"
                       class="control-label fw-bold">
                    Device Identifier
                </label>

                <input asp-for="DeviceIdentifier"
                       class="form-control"
                       placeholder="ESP32-0201" />

                <span asp-validation-for="DeviceIdentifier"
                      class="text-danger field-validation-error">
                </span>

            </div>

            <div class="sensor-form-group">

                <label asp-for="MacAddress"
                       class="control-label fw-bold">
                    MAC Address
                </label>

                <input asp-for="MacAddress"
                       class="form-control"
                       placeholder="AA:BB:CC:DD:EE:FF" />

                <span asp-validation-for="MacAddress"
                      class="text-danger field-validation-error">
                </span>

            </div>

            <div class="sensor-form-group">

                <label asp-for="Room"
                       class="control-label fw-bold">
                    Room
                </label>

                <input asp-for="Room"
                       class="form-control"
                       placeholder="Server Room" />

                <span asp-validation-for="Room"
                      class="text-danger field-validation-error">
                </span>

            </div>

            <div class="sensor-form-group">

                <label asp-for="Zone"
                       class="control-label fw-bold">
                    Zone
                </label>

                <input asp-for="Zone"
                       class="form-control"
                       placeholder="Zone A" />

                <span asp-validation-for="Zone"
                      class="text-danger field-validation-error">
                </span>

            </div>

            <div class="sensor-form-group">

                <label asp-for="NodeId"
                       class="control-label fw-bold">
                    Node ID
                </label>

                <input asp-for="NodeId"
                       class="form-control"
                       placeholder="NODE-001" />

                <span asp-validation-for="NodeId"
                      class="text-danger field-validation-error">
                </span>

            </div>

            <div class="sensor-form-group">

                <label asp-for="Category"
                       class="control-label fw-bold">
                    Category
                </label>

                <select asp-for="Category"
                        class="form-select">

                    <option value="Environmental">
                        Environmental
                    </option>

                    <option value="PowerConsumption">
                        Power Consumption
                    </option>

                    <option value="Actuator">
                        Actuator
                    </option>

                </select>

            </div>

            <div class="sensor-form-group">

                <label class="control-label fw-bold">
                    Attach Config / Log File
                </label>

                <input type="file"
                       name="file"
                       class="form-control" />

                <span class="file-help">
                    Optional: upload a sensor configuration or log file.
                </span>

            </div>

            <div class="form-actions">

                <!--
                    Bootstrap button classes are used to create the primary
                    form submission control (Bootstrap, 2026c).
                -->

                <div class="d-grid">

                    <input type="submit"
                           value="Register Sensor"
                           class="btn btn-success register-btn" />

                </div>

            </div>

        </form>

        <div class="text-center mt-4">

            <a asp-action="Index"
               class="btn btn-secondary back-btn">
                Back to List
            </a>

        </div>

    </div>

</div>

@section Scripts {

    @{
        @*
            The validation scripts enable client-side validation for the
            asp-validation-for elements before the form is submitted
            (Microsoft, 2026y).
        *@

        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

