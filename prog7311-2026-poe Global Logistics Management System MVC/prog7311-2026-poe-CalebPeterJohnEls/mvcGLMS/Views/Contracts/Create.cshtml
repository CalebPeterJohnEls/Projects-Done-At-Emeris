@model mvcGLMS.Models.Contract

@{
    ViewData["Title"] = "Create";
}

<div class="container d-flex justify-content-center" style="min-height: 80vh; align-items: center;">

    <div class="col-md-5">

        <h1 class="text-center">Create</h1>
        <h4 class="text-center">Contract</h4>
        <hr />

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ClientId" class="control-label fw-bold"></label>
                <select asp-for="ClientId" class="form-control" asp-items="ViewBag.ClientId"></select>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartDate" class="control-label fw-bold"></label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndDate" class="control-label fw-bold"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label fw-bold"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Draft">Draft</option>
                    <option value="Active">Active</option>
                    <option value="On Hold">On Hold</option>
                    <option value="Expired">Expired</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Upload Agreement PDF</label>
                <input type="file" name="upload" class="form-control" accept="application/pdf" />
                <span asp-validation-for="SignedAgreementPath" class="text-danger"></span>
            </div>
            <!--//(Microsoft, 2025;Troelsen, A. and Japikse, P., 2022;Stack Overflow, 2016)-->

            <div class="form-group mb-3">
                <label asp-for="ServiceLevel" class="control-label fw-bold"></label>
                <select asp-for="ServiceLevel" class="form-select">
                    <option value="Bronze">Bronze</option>
                    <option value="Silver">Silver</option>
                    <option value="Gold">Gold</option>
                    <option value="Platinum">Platinum</option>
                </select>
                <span asp-validation-for="ServiceLevel" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <input type="submit" value="Create" class="btn btn-success" />
            </div>

        </form>

        <div class="text-center mt-3">
            <a asp-action="Index" class="btn btn-success">Back to List</a>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
