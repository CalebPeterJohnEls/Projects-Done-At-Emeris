@model mvcGLMS.Models.Contract

@{
    ViewData["Title"] = "Details";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="col-md-6 text-center">

        <h1>Details</h1>
        <h4>Contract</h4>
        <hr />

        <dl class="row text-start">

            <dt class="col-sm-4 fw-bold">
                @Html.DisplayNameFor(model => model.Client)
            </dt>
            <dd class="col-sm-8">
                @if (Model?.Client != null)
                {
                    @Model.Client.Name
                }
            </dd>

            <dt class="col-sm-4 fw-bold">
                @Html.DisplayNameFor(model => model.StartDate)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.StartDate)
            </dd>

            <dt class="col-sm-4 fw-bold">
                @Html.DisplayNameFor(model => model.EndDate)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.EndDate)
            </dd>

            <dt class="col-sm-4 fw-bold">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Status)
            </dd>

            <dt class="col-sm-4 fw-bold">
                @Html.DisplayNameFor(model => model.ServiceLevel)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ServiceLevel)
            </dd>

            <dt class="col-sm-4 fw-bold">
                @Html.DisplayNameFor(model => model.SignedAgreementPath)
            </dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model?.SignedAgreementPath))
                {
                    <a href="@Url.Content(Model!.SignedAgreementPath)" target="_blank" class="btn btn-primary btn-sm">
                        View Contract
                    </a>
                }
                else
                {
                    <p>NO DOCUMENT</p>
                }
            </dd>

        </dl>

        @*(Troelsen, and Japikse, 2022; The IIE. 2026; Refactoring Guru, 2024b; TutorialsPoint, 2026; W3Schools, 2025c.)
        Service Requests section: demonstrates the Contract to ServiceRequest Composite structure*@
        <h4 class="mt-4 mb-3 text-start">Service Requests</h4>

        @if (Model?.ServiceRequests != null && Model.ServiceRequests.Any())
        {
            <table class="table table-sm table-hover shadow-sm bg-light rounded">
                <thead class="table-light">
                    <tr style="font-size: 0.9rem;">
                        <th style="background-color: lightgreen">Description</th>
                        <th style="background-color: lightgreen">USD</th>
                        <th style="background-color: lightgreen">ZAR</th>
                        <th style="background-color: lightgreen">Status</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.9rem;">
                @foreach (var sr in Model.ServiceRequests)
                {
                    <tr>
                        <td>@sr.Description</td>
                        <td>
                            @sr.CostUSD.ToString("C", new System.Globalization.CultureInfo("en-US"))
                        </td>
                        <td>
                            @sr.CostZAR.ToString("C", new System.Globalization.CultureInfo("en-ZA"))
                        </td>
                        <td>
                            @{
                                var statusClass = sr.Status == "Completed" ? "bg-success" :
                                                  sr.Status == "Pending" ? "bg-warning text-dark" :
                                                  "bg-secondary";
                            }
                            <span class="badge @statusClass" style="font-size: 0.75rem;">
                                @sr.Status
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info mt-2 p-2" style="font-size: 0.9rem;">
                No service requests found for this contract.
            </div>
        }

        <div class="d-flex justify-content-center gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-success">Edit</a>
            <a asp-action="Index" class="btn btn-success">Back to List</a>
        </div>

        <hr />

