@model IEnumerable<mvcGLMS.Models.Contract>

@{

    ViewData["Title"] = "Contracts List";
}
   @{
                            /*Calls Role from sessions in Account controller and declares it as a variable* 
                            Admin: admin1 1234*/
                            var role = Context.Session.GetString("Role");
                        }
<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1>Contracts</h1>

    <!-- Button to Create Contract page -->
    <a asp-action="Create" class="btn btn-primary">Create New Contract</a>
</div>

<!--Filter Form that filters content based on status date range (Stack Overflow, 2010b)-->
<form asp-action="Index" method="get" class="form-inline mb-3">

    <div class="form-row">

        <!-- Status search filter -->
        <div class="form-group col-md-3">
            <label for="statusFilter">Search by Status</label>
            <input type="text"
                   class="form-control"
                   id="statusFilter"
                   name="statusFilter"
                   value="@ViewBag.StatusFilter" />
        </div>

        <br />

        <!-- Start date filter -->
        <div class="form-group col-md-3">
            <label>Start Date</label>
            <input type="date"
                   class="form-control"
                   name="startDate"
                   value="@ViewBag.StartDate" />
        </div>

        <br />

        <!-- End date filter -->
        <div class="form-group col-md-3">
            <label>End Date</label>
            <!-- FIXED TYPO: value (not "alue") -->
            <input type="date"
                   class="form-control"
                   name="endDate"
                   value="@ViewBag.EndDate" />
        </div>

        <br />

        <!-- Submit filter button -->
        <button type="submit" class="btn btn-primary">Filter</button>

    </div>
</form>

<br />
<br />

<!-- Tbale with all contracts -->
<table class="table table-hover shadow-sm bg-limegreen rounded">

    <thead class="table-light">
        <tr>
            <th style="background-color: lightgreen">ID</th>
            <th style="background-color: lightgreen">Client</th>
            <th style="background-color: lightgreen">
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th style="background-color: lightgreen">
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th style="background-color: lightgreen">
                @Html.DisplayNameFor(model => model.ServiceLevel)
            </th>
            <th style="background-color: lightgreen">
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th style="background-color: lightgreen">
                @Html.DisplayNameFor(model => model.SignedAgreementPath)
            </th>
              @if (role == "Admin")
                        {
            <th style="background-color: lightgreen" class="text-center">
                Actions
            </th>
            }
        </tr>
    </thead>

    <tbody>

        <!-- Loop through all contracts -->
        @foreach (var item in Model)
        {
            <tr>

                <!-- Contract ID -->
                <td>@item.Id</td>

                <!-- Client details  -->
                <td>
                    <strong>@item.Client?.Name</strong>
                    <br />
                    <small class="text-muted">ID: @item.Client?.Id</small>
                </td>

                <!-- Dates -->
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EndDate.ToShortDateString()</td>

                <!-- Service Level -->
                <td>
                    <span class="badge bg-info text-dark">
                        @item.ServiceLevel
                    </span>
                </td>

                <!-- Status with conditional styling -->
                <td>
                    @{
                        var statusClass = item.Status == "Active" ? "bg-success" :
                                          item.Status == "Pending" ? "bg-warning text-dark" :
                                          "bg-secondary";
                    }

                    <span class="badge @statusClass">
                        @item.Status
                    </span>
                </td>

                <!-- Signed document -->
                <td>
                    @if (!string.IsNullOrEmpty(item.SignedAgreementPath))
                    {
                        <!-- Link to PDF file -->
                        <a href="@Url.Content(item.SignedAgreementPath)"
                           target="_blank"
                           class="btn btn-primary btn-sm">
                            View Contract
                        </a>
                    }
                    else
                    {
                        <p>NO DOCUMENT</p>
                    }
                </td>

                <!-- Action buttons -->
               

                @if (role == "Admin")
                        {
                            
                        
                <td class="text-center">

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary"
                       style="background-color: aquamarine; color: white">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-info"
                       style="background-color: rgb(69, 220, 233); color: white">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger"
                       style="background-color: red; color: white">
                        Delete
                    </a>

                </td>
}
            </tr>
        }

    </tbody>
</table>
