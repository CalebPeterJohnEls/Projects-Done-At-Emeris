@model IEnumerable<mvcGLMS.Models.Client>

@{
    ViewData["Title"] = "Clients List";
}
   @{
                            /*Calls Role from sessions in Account controller and declares it as a variable* 
                            Admin: admin1 1234*/
                            var role = Context.Session.GetString("Role");
                        }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1>Clients</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Client</a>
</div>

<table class="table table-hover shadow-sm bg-white rounded">
    <thead class="table-light">
        <tr>
            <th style="background-color: lightgreen">ID</th>
            <th style="background-color: lightgreen">@Html.DisplayNameFor(model => model.Name)</th>
            <th style="background-color: lightgreen">@Html.DisplayNameFor(model => model.ContactDetails)</th>
            <th style="background-color: lightgreen">@Html.DisplayNameFor(model => model.Region)</th>
             @if (role == "Admin")
                        { <th style="background-color: lightgreen" class="text-center">Actions</th>}
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Id
            </td>
            <td>
                <strong>@item.Name</strong>
            </td>
            <td>
                <small class="text-muted">@item.ContactDetails</small>
            </td>
            <td>
                <span class="badge bg-info text-dark">
                    @item.Region
                </span>
                   </td>    
                   @if (role == "Admin")
                        {
       
            <td class="text-center">
               <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" style="background-color: aquamarine; color: white">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" style="background-color: rgb(69, 220, 233); color: white">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" style="background-color: red; color: white">Delete</a>
            </td>
                }
        </tr>
}
    </tbody>
</table>
