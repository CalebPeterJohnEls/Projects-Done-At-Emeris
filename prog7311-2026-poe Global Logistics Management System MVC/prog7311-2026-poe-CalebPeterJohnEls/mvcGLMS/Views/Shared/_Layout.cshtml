<!DOCTYPE html>
<html lang="en">
<head>
    <!--https://www.w3schools.com/css/css3_mediaqueries.asp
    https://dev.to/paulallies/creating-a-responsive-side-navigation-bar-with-html-css-and-javascript-3538
    https://fontawesome.com/search
    https://www.youtube.com/watch?v=Fx_NpAPM-iU
    https://www.youtube.com/watch?v=mtA__aN2UJA 
    -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechMove: GLMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/mvcGLMS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <style>

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: rgb(66, 80, 80) !important;
            color: white;
            display: flex;
            flex-direction: column;
        }

        #top-bar {
            height: 52px;
            background-color: rgb(44, 58, 58);
            display: flex;
            align-items: center;
            padding: 0 16px 0 64px;
            border-bottom: 1px solid rgba(148, 226, 128, 0.2);
            flex-shrink: 0;
            z-index: 20;
        }

        #top-bar .brand {
            font-size: 16px;
            font-weight: 700;
            color: rgb(130, 223, 215);
            letter-spacing: 2px;
            text-decoration: none;
            margin-right: auto;
        }

        #top-bar .user-info {
            font-size: 23px;
            color: rgba(255, 255, 255, 0.75);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        #top-bar .user-info span {
            color: #94e280;
            font-weight: 500;
        }

        #top-bar .btn-logout {
            background: rgba(148, 226, 128, 0.15);
            color: #94e280;
            border: 1px solid rgba(148, 226, 128, 0.35);
            border-radius: 4px;
            padding: 4px 12px;
            font-size: 12px;
            cursor: pointer;
            text-decoration: none;
        }

        #top-bar .btn-logout:hover {
            background: rgba(148, 226, 128, 0.3);
            color: #94e280;
        }

        #top-bar .btn-login {
            color: rgba(255,255,255,0.75);
            font-size: 13px;
            text-decoration: none;
            padding: 4px 10px;
            border-radius: 4px;
        }

        #top-bar .btn-login:hover {
            color: #94e280;
            background: rgba(148, 226, 128, 0.1);
        }

        #page-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
            height: calc(100vh - 52px);
        }

        #sidenav {
            width: 220px;
            min-width: 220px;
            height: 100%;
            background-color: rgb(44, 58, 58);
            border-right: 1px solid rgba(148, 226, 128, 0.12);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            flex-shrink: 0;
            z-index: 15;
            transition: width 0.3s ease, min-width 0.3s ease;
        }

        #sidenav.min {
            width: 56px;
            min-width: 56px;
        }

        .nav-section-label {
            font-size: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            padding: 18px 18px 6px 18px;
            white-space: nowrap;
            overflow: hidden;
        }

        #sidenav.min .nav-section-label {
            opacity: 0;
        }

        #sidenav ul {
            list-style: none;
            padding: 4px 0;
        }

        #sidenav ul li a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            font-size: 13.5px;
            white-space: nowrap;
            border-left: 3px solid transparent;
            position: relative;
        }

        #sidenav ul li a:hover {
            color: #94e280;
            background: rgba(148, 226, 128, 0.08);
            border-left-color: rgba(148, 226, 128, 0.4);
            text-decoration: none;
        }

        #sidenav ul li a.active {
            color: #94e280;
            background: rgba(148, 226, 128, 0.12);
            border-left-color: #94e280;
        }

        #sidenav ul li a i {
            font-size: 16px;
            flex-shrink: 0;
            width: 20px;
            text-align: center;
        }

        .nav-label {
            overflow: hidden;
        }

        #sidenav.min .nav-label {
            opacity: 0;
            width: 0;
        }

        #sidenav.min ul li a::after {
            content: attr(data-label);
            position: absolute;
            left: 58px;
            background: rgb(30, 42, 42);
            color: #94e280;
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 4px;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            z-index: 100;
            border: 1px solid rgba(148, 226, 128, 0.25);
        }

        #sidenav.min ul li a:hover::after {
            opacity: 1;
        }

        .nav-divider {
            border: none;
            border-top: 1px solid rgba(255,255,255,0.07);
            margin: 8px 16px;
        }

        .nav-spacer {
            flex: 1;
        }

        #sidenav-toggle {
            position: fixed;
            left: 12px;
            top: 12px;
            z-index: 30;
            background: transparent;
            color: rgba(255,255,255,0.6);
            border: none;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 4px;
            font-size: 16px;
        }

        #sidenav-toggle:hover {
            color: #94e280;
            background: rgba(148, 226, 128, 0.1);
        }

        #main-content {
            flex: 1;
            overflow-y: auto;
            padding: 28px 32px 60px 32px;
        }

        .footer {
            font-size: 12px;
            color: rgba(255,255,255,0.35);
            padding: 10px 32px;
            border-top: 1px solid rgba(255,255,255,0.07);
            flex-shrink: 0;
            text-align: center;
        }

        h1 {
            font-family: Arial;
            color: #94e280;
        }

        a, a:visited {
            color: white;
            text-decoration: underline;
        }

        a:hover {
            color: lightgreen;
        }

        table, td, tr {
            border: 2px solid aliceblue;
            background-color: palegreen;
        }

        table th {
            background: #007bff;
            color: white;
            text-transform: uppercase;
        }

        #nav-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            z-index: 10;
        }

        @@media (max-width: 768px) {
            #sidenav {
                position: fixed;
                left: -220px;
                top: 0;
                height: 100%;
                z-index: 20;
                min-width: 220px;
                width: 220px;
            }

            #sidenav.mobile-open {
                left: 0;
            }

            #nav-overlay.visible {
                display: block;
            }

            #main-content {
                padding: 16px 16px 60px 16px;
            }
        }

    </style>
</head>

<body>

    <div id="nav-overlay" onclick="closeMobileNav()"></div>

    <button id="sidenav-toggle" onclick="toggleSidenav()" aria-label="Toggle navigation">
        <i class="fa fa-bars"></i>
    </button>

    <header id="top-bar">
       <a class="brand" asp-controller="Home" asp-action="Index">
        <img src="~/images/logo.png" alt="TechMove GLMS Logo" style="height: 32px; width: auto; vertical-align: middle; margin-right: 8px;" />
        TechMove: GLMS
    </a>

        <div class="user-info">
            @if (!string.IsNullOrEmpty(Context.Session.GetString("Username")))
            {
                <span>Hello, @Context.Session.GetString("Username")!</span>
            }
        </div>
    </header>

    <div id="page-wrapper">

        <nav id="sidenav" aria-label="Main navigation">

            <p class="nav-section-label">Menu</p>

            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       data-label="Home">
                        <i class="fa fa-home" aria-hidden="true"></i>
                        <span class="nav-label">Home</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Contracts" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Contracts" ? "active" : "")"
                       data-label="Contracts">
                        <i class="fa fa-file-alt" aria-hidden="true"></i>
                        <span class="nav-label">Contracts</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Client" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Client" ? "active" : "")"
                       data-label="Clients">
                        <i class="fa fa-users" aria-hidden="true"></i>
                        <span class="nav-label">Clients</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="ServiceRequest" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequest" ? "active" : "")"
                       data-label="Service Requests">
                        <i class="fa fa-clipboard" aria-hidden="true"></i>
                        <span class="nav-label">Service Requests</span>
                    </a>
                </li>
            </ul>

            <div class="nav-spacer"></div>
            <hr class="nav-divider" />
            <p class="nav-section-label">Account</p>

            <ul>
                @if (!string.IsNullOrEmpty(Context.Session.GetString("Username")))
                {
                    <li>
                        <a href="#" data-label="Logout"
                           onclick="document.getElementById('logout-form').submit(); return false;">
                            <i class="fa fa-sign-out-alt" aria-hidden="true"></i>
                            <span class="nav-label">Logout</span>
                        </a>
                    </li>
                    <form id="logout-form" asp-controller="Account" asp-action="Logout" method="post" style="display:none;"></form>
                }
                else
                {
                    <li>
                        <a asp-controller="Account" asp-action="Login"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : "")"
                           data-label="Login">
                            <i class="fa fa-sign-in-alt" aria-hidden="true"></i>
                            <span class="nav-label">Login</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Account" asp-action="Register"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Register" ? "active" : "")"
                           data-label="Register">
                            <i class="fa fa-user-plus" aria-hidden="true"></i>
                            <span class="nav-label">Register</span>
                        </a>
                    </li>
                }
            </ul>

            <div style="height: 16px;"></div>

        </nav>

        <div style="flex:1; display:flex; flex-direction:column; overflow:hidden;">

            <main id="main-content" role="main">
                @RenderBody()
            </main>

            <footer class="footer">
                &copy; 2026 - GLMS - ST10306162
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleSidenav() {
            const nav = document.getElementById('sidenav');
            const overlay = document.getElementById('nav-overlay');
            if (window.innerWidth <= 768) {
                nav.classList.remove('min');
                nav.classList.toggle('mobile-open');
                overlay.classList.toggle('visible', nav.classList.contains('mobile-open'));
            } else {
                nav.classList.remove('mobile-open');
                nav.classList.toggle('min');
            }
        }

        function closeMobileNav() {
            document.getElementById('sidenav').classList.remove('mobile-open');
            document.getElementById('nav-overlay').classList.remove('visible');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

