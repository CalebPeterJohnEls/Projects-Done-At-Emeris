<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="14dp"

    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/teal_primary">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/skillName"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Grip"

            android:textColor="@color/card_white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/skillDescription"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Improve your technique"

            android:textColor="@color/card_white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/skillProgressText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:text="Not attempted yet"

            android:textColor="@color/card_white"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/skillProgress"

            style="?android:attr/progressBarStyleHorizontal"

            android:layout_width="match_parent"
            android:layout_height="7dp"

            android:layout_marginTop="7dp"

            android:max="100"
            android:progress="0" />

        <Button
            android:id="@+id/startSkillButton"

            android:layout_width="match_parent"
            android:layout_height="48dp"

            android:layout_marginTop="14dp"

            android:text="START PRACTICE"
            android:textAllCaps="false"
            android:textStyle="bold"

            android:background="@drawable/bg_button_outline_pill"
            android:textColor="@color/teal_deep" />

    </LinearLayout>

</androidx.cardview.widget.CardView>