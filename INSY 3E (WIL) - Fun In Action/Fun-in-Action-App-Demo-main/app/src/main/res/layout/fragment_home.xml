<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/teal_light"

    tools:context=".HomeFragment">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeGreeting"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Hi, Player!"

                android:textColor="@color/text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeAvatar"

                android:layout_width="40dp"
                android:layout_height="40dp"

                android:background="@drawable/bg_avatar_circle"

                android:gravity="center"

                android:text="P"
                android:textColor="@color/card_white"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- LEVEL -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="18dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="YOUR LEVEL"

                    android:textColor="@color/teal_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/levelText"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:background="@drawable/bg_button_pill_gradient"

                    android:paddingHorizontal="16dp"
                    android:paddingVertical="7dp"

                    android:text="★ Level 1"

                    android:textColor="@color/card_white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/levelXpText"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="0 / 200 XP"

                    android:textColor="@color/text_grey"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/levelProgress"

                    style="?android:attr/progressBarStyleHorizontal"

                    android:layout_width="match_parent"
                    android:layout_height="8dp"

                    android:layout_marginTop="8dp"

                    android:max="200"
                    android:progress="0"

                    android:progressDrawable="@drawable/bg_pill_progress" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- SKILL PROGRESS -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="18dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="SKILL PROGRESS"

                    android:textColor="@color/teal_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gripProgressText"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Not attempted yet"

                    android:textColor="@color/text_dark" />

                <ProgressBar
                    android:id="@+id/gripProgress"

                    style="?android:attr/progressBarStyleHorizontal"

                    android:layout_width="match_parent"
                    android:layout_height="7dp"

                    android:layout_marginTop="6dp"

                    android:max="100"
                    android:progress="0"

                    android:progressDrawable="@drawable/bg_pill_progress" />

                <TextView
                    android:id="@+id/passProgressText"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="Not attempted yet"

                    android:textColor="@color/text_dark" />

                <ProgressBar
                    android:id="@+id/passProgress"

                    style="?android:attr/progressBarStyleHorizontal"

                    android:layout_width="match_parent"
                    android:layout_height="7dp"

                    android:layout_marginTop="6dp"

                    android:max="100"
                    android:progress="0"

                    android:progressDrawable="@drawable/bg_pill_progress" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- RECENT PRACTICE -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="18dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="RECENT PRACTICE"

                    android:textColor="@color/teal_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recentPracticeText"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="No practice completed yet."

                    android:textColor="@color/text_dark"
                    android:textSize="15sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- CERTIFICATE -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="18dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="CERTIFICATE"

                    android:textColor="@color/teal_primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/certificateText"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="4 practice attempts required."

                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/certificateProgress"

                    style="?android:attr/progressBarStyleHorizontal"

                    android:layout_width="match_parent"
                    android:layout_height="8dp"

                    android:layout_marginTop="10dp"

                    android:max="4"
                    android:progress="0"

                    android:progressDrawable="@drawable/bg_pill_progress" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnPracticeStance"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"

            android:background="@drawable/bg_button_pill_gradient"

            android:text="Practice a Skill"
            android:textAllCaps="false"

            android:textColor="@color/card_white"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>