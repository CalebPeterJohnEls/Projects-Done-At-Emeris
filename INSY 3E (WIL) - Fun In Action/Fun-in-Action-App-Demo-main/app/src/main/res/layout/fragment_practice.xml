<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/teal_light"

    android:padding="20dp"

    tools:context=".PracticeFragment">

    <TextView
        android:id="@+id/practiceTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Practice"

        android:textColor="@color/text_dark"
        android:textSize="26sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/practiceSubtitle"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="6dp"

        android:text="Choose a skill and improve your technique."

        android:textColor="@color/text_grey"
        android:textSize="14sp"

        app:layout_constraintTop_toBottomOf="@id/practiceTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/skillsRecyclerView"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="18dp"

        android:clipToPadding="false"
        android:paddingBottom="20dp"

        app:layout_constraintTop_toBottomOf="@id/practiceSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>