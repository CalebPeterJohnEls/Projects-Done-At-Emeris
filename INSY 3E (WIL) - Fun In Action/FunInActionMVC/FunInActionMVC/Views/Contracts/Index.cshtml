@model List<Contract>

<div class="fia-inner">

    <section class="fia-page-header">
        <h1><i class="fa fa-file-alt"></i> Contracts</h1>
        <p>Agreements and consent forms needed before a player joins a session.</p>
    </section>

    <section class="fia-section" style="margin-top:0;">
        @foreach (var c in Model)
        {
            var isSigned = c.Status == ContractStatus.Signed;
            var badgeClass = isSigned ? "fia-badge-green" : "fia-badge-yellow";
            <div class="fia-contract-item">
                <i class="fa @c.Icon doc-icon"></i>
                <div class="body">
                    <strong>@c.Title</strong>
                    <span>@c.Description</span>
                </div>
                <span class="fia-badge @badgeClass">@c.Status</span>
                @if (isSigned)
                {
                    <a asp-action="Details" asp-route-id="@c.Id" class="fia-btn-outline">View</a>
                }
                else
                {
                    <a asp-action="Details" asp-route-id="@c.Id" asp-fragment="sign" class="fia-btn">Review &amp; sign</a>
                }
            </div>
        }
    </section>

</div>