@model List<PaymentMethodInfo>
@{
    ViewData["PageCss"] = "stylepayments.css";
    var fee = (ProgrammeFeeSummary)ViewBag.FeeSummary;
    var payments = (ViewBag.Payments as List<PaymentRecord>) ?? new();
    var feeAmount = "R" + fee.TotalAmount.ToString("N0");        // built in C# so Razor can't misread "R@fee..."
    var regFeeAmount = "R" + fee.RegistrationFee.ToString("N0");
}

<div class="fia-inner">

   

    <section class="fia-section">
        <h2><i class="fa fa-receipt"></i> Payments Made</h2>

        @if (payments.Count == 0)
        {
            <div class="fia-note">No payments have been recorded yet.</div>
        }
        else
        {
            <div class="fia-table-wrap">
                <table class="fia-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Description</th>
                            <th>Method</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Change Status</th>   @* NEW *@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in payments.OrderByDescending(x => x.Date))
                        {
                            var badge = p.Status switch
                            {
                                PaymentStatus.Confirmed => "fia-badge-green",
                                PaymentStatus.Failed    => "fia-badge-red",
                                _                       => "fia-badge-yellow"
                            };
                            <tr>
                                <td>@p.Date.ToString("dd MMM yyyy")</td>
                                <td>@p.ClientId</td>
                                <td>@p.Description</td>
                                <td>@p.Method</td>
                                <td>@("R" + p.Amount.ToString("N2"))</td>
                                <td><span class="fia-badge @badge">@p.Status</span></td>
                                <td>
                                    @* NEW: saves as soon as the dropdown changes. The form tag helper adds the anti-forgery token. *@
                                    <form asp-controller="Payments" asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <select name="status" onchange="this.form.submit()"
                                                aria-label="Change status"
                                                style="border:1.5px solid #CFF2F3; border-radius:8px; padding:6px 10px; font-size:13px; background:#F5FDFD; cursor:pointer;">
                                            @foreach (var s in Enum.GetValues<PaymentStatus>())
                                            {
                                                <option value="@s" selected="@(s == p.Status)">@s</option>
                                            }
                                        </select>
                                        <noscript><button type="submit" class="fia-btn" style="border:none;">Save</button></noscript>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>