@{
    var pageCss = ViewData["PageCss"] as string ?? "style.css";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Fun in Action") - Fun in Action</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/@pageCss" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main style="max-width:560px; margin:48px auto; padding:0 16px;">
        <div style="text-align:center; margin-bottom:24px;">
            <img src="~/assets/logo_mark.png" alt="Fun in Action Logo" style="height:48px;" />
            <h1 style="font-family:'Fredoka One',sans-serif; font-size:1.6rem;">Fun in Action</h1>
        </div>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>