@{
    var isRegister = (ViewData["Mode"] as string) == "register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Login") - Fun in Action</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" rel="stylesheet">

    <style>
        :root { --auth-blue: #2271ff; --auth-blue-dark: #1a5ad1; }

        .auth-page, .auth-page * { margin: 0; padding: 0; box-sizing: border-box; }
        .auth-page { font-family: 'Lato', sans-serif; background: #fff; }

        .auth-container { position: relative; width: 100%; background: #fff; min-height: max(100vh, 720px); overflow: hidden; }

        /* forms side */
        .forms-container { position: absolute; width: 100%; height: 100%; top: 0; left: 0; }
        .signin-signup { position: absolute; top: 50%; left: 75%; width: 50%; transform: translate(-50%, -50%);
            transition: 1s 0.7s ease-in-out; display: grid; grid-template-columns: 1fr; z-index: 5; }
        .auth-form { display: flex; align-items: center; justify-content: center; flex-direction: column;
            padding: 0 4rem; transition: all 0.2s 0.7s; grid-column: 1 / 2; grid-row: 1 / 2; }
        .auth-form.sign-in-form { z-index: 2; opacity: 1; visibility: visible; }
        .auth-form.sign-up-form { z-index: 1; opacity: 0; visibility: hidden; }
        .auth-logo { height: 44px; width: 44px; object-fit: contain; margin-bottom: 6px; }
        .auth-form .title { font-size: 2.2rem; font-weight: 900; color: #444; margin-bottom: 10px; }

        .auth-field { width: 100%; max-width: 380px; margin: 6px 0; }
        .sign-up-form .auth-field, .sign-up-form .auth-row { max-width: 460px; }
        .auth-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; width: 100%; }

        .input-field { width: 100%; background: #f0f0f0; height: 48px; border-radius: 48px; display: grid;
            grid-template-columns: 2.6rem 1fr; padding: 0 0.6rem 0 0.4rem; border: 2px solid transparent;
            transition: border-color .3s, background-color .3s; }
        .input-field:focus-within { background: #fff; border-color: var(--auth-blue); }
        .input-field i { text-align: center; line-height: 44px; color: #acacac; transition: .3s; font-size: 1rem; }
        .input-field:focus-within i { color: var(--auth-blue); }
        .input-field input, .input-field select { background: none; outline: none; border: none; width: 100%;
            min-width: 0; font-family: inherit; font-weight: 700; font-size: 1rem; color: #333; }
        .input-field select { cursor: pointer; }
        .input-field input::placeholder { color: #aaa; font-weight: 500; }

        .field-err, .auth-summary { display: block; color: #d93535; font-size: .78rem; font-weight: 700; padding: 3px 0 0 1rem; }
        .auth-summary { text-align: center; padding: 0 0 6px; }
        .auth-summary ul { list-style: none; }
        .field-err:empty { display: none; }

        .auth-btn { display: inline-flex; align-items: center; justify-content: center; width: 150px; height: 49px;
            background: var(--auth-blue); border: none; outline: none; border-radius: 49px; color: #fff;
            text-transform: uppercase; text-decoration: none; font-family: inherit; font-weight: 700;
            margin: 12px 0 4px; cursor: pointer; transition: .4s; }
        .auth-btn:hover { background: var(--auth-blue-dark); }

        .auth-toast { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 20;
            background: var(--auth-blue); color: #fff; font-weight: 700; padding: 10px 22px; border-radius: 30px;
            box-shadow: 0 6px 20px rgba(0,0,0,.18); }
        .auth-toast.error { background: #d93535; }

        /* blue sliding panel */
        .panels-container { position: absolute; height: 100%; width: 100%; top: 0; left: 0;
            display: grid; grid-template-columns: repeat(2, 1fr); }
        .auth-container:before { content: ""; position: absolute; height: 2000px; width: 2000px; top: -10%; right: 48%;
            transform: translateY(-50%); background: var(--auth-blue); transition: 1.8s ease-in-out;
            border-radius: 50%; z-index: 6; }
        .panel { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-around;
            text-align: center; z-index: 6; }
        .left-panel { pointer-events: all; padding: 3rem 17% 2rem 12%; }
        .right-panel { pointer-events: none; padding: 3rem 12% 2rem 17%; }
        .panel .content { color: #fff; transition: transform .9s ease-in-out; transition-delay: .6s; }
        .panel h3 { font-weight: 900; line-height: 1; font-size: 1.6rem; }
        .panel p { font-size: .95rem; padding: .7rem 0; }
        .panel .image { width: 100%; transition: transform 1.1s ease-in-out; transition-delay: .4s; }
        .auth-btn.transparent { margin: 0; background: none; border: 2px solid #fff; width: 130px; height: 41px; font-size: .8rem; }
        .auth-btn.transparent:hover { background: rgba(255,255,255,.15); }
        .right-panel .image, .right-panel .content { transform: translateX(800px); }

        /* register mode */
        .auth-container.sign-up-mode:before { transform: translate(100%, -50%); right: 52%; }
        .auth-container.sign-up-mode .left-panel .image,
        .auth-container.sign-up-mode .left-panel .content { transform: translateX(-800px); }
        .auth-container.sign-up-mode .signin-signup { left: 25%; }
        .auth-container.sign-up-mode .auth-form.sign-up-form { opacity: 1; visibility: visible; z-index: 2; }
        .auth-container.sign-up-mode .auth-form.sign-in-form { opacity: 0; visibility: hidden; z-index: 1; }
        .auth-container.sign-up-mode .right-panel .image,
        .auth-container.sign-up-mode .right-panel .content { transform: translateX(0); }
        .auth-container.sign-up-mode .left-panel { pointer-events: none; }
        .auth-container.sign-up-mode .right-panel { pointer-events: all; }

        @@media (max-width: 870px) {
            .auth-container { min-height: 1050px; }
            .signin-signup { width: 100%; top: 95%; transform: translate(-50%, -100%); transition: 1s .8s ease-in-out; }
            .signin-signup, .auth-container.sign-up-mode .signin-signup { left: 50%; }
            .panels-container { grid-template-columns: 1fr; grid-template-rows: 1fr 2fr 1fr; }
            .panel { flex-direction: row; justify-content: space-around; align-items: center; padding: 2.5rem 8%; grid-column: 1 / 2; }
            .right-panel { grid-row: 3 / 4; }
            .left-panel { grid-row: 1 / 2; }
            .panel .image { width: 200px; transition: transform .9s ease-in-out; transition-delay: .6s; }
            .panel .content { padding-right: 15%; transition: transform .9s ease-in-out; transition-delay: .8s; }
            .panel h3 { font-size: 1.2rem; }
            .panel p { font-size: .7rem; padding: .5rem 0; }
            .auth-btn.transparent { width: 110px; height: 35px; font-size: .7rem; }
            .auth-container:before { width: 1500px; height: 1500px; transform: translateX(-50%); left: 30%;
                bottom: 68%; right: initial; top: initial; transition: 2s ease-in-out; }
            .auth-container.sign-up-mode:before { transform: translate(-50%, 100%); bottom: 32%; right: initial; }
            .auth-container.sign-up-mode .left-panel .image,
            .auth-container.sign-up-mode .left-panel .content { transform: translateY(-300px); }
            .auth-container.sign-up-mode .right-panel .image,
            .auth-container.sign-up-mode .right-panel .content { transform: translateY(0); }
            .right-panel .image, .right-panel .content { transform: translateY(300px); }
            .auth-container.sign-up-mode .signin-signup { top: 5%; transform: translate(-50%, 0); }
        }
        @@media (max-width: 570px) {
            .auth-form { padding: 0 1.5rem; }
            .panel .image { display: none; }
            .panel .content { padding: .5rem 1rem; }
            .auth-row { grid-template-columns: 1fr; }
            .auth-container:before { bottom: 72%; left: 50%; }
            .auth-container.sign-up-mode:before { bottom: 28%; left: 50%; }
        }
    </style>
</head>
<body class="auth-page">

    @if (TempData["ToastMessage"] is string toast)
    {
        var isError = TempData["ToastIsError"] is bool b && b;
        <div class="auth-toast @(isError ? "error" : "")">@toast</div>
    }

    <div class="auth-container @(isRegister ? "sign-up-mode" : "")" id="auth-container"
         data-login-url="@Url.Action("Login", "Account")"
         data-register-url="@Url.Action("Register", "Account")">

        <div class="forms-container">
            <div class="signin-signup">
                @RenderSection("LoginForm")
                @RenderSection("RegisterForm")
            </div>
        </div>

        <div class="panels-container">
            <div class="panel left-panel">
                <div class="content">
                    <h3>New here?</h3>
                    <p>Create an account and get started with Fun in Action.</p>
                    <a class="auth-btn transparent" id="sign-up-btn" href="@Url.Action("Register", "Account")">Register</a>
                </div>
                <img src="~/assets/auth-login.svg" class="image" alt="" />
            </div>
            <div class="panel right-panel">
                <div class="content">
                    <h3>One of us?</h3>
                    <p>Log in to pick up where you left off.</p>
                    <a class="auth-btn transparent" id="sign-in-btn" href="@Url.Action("Login", "Account")">Log in</a>
                </div>
                <img src="~/assets/auth-register.svg" class="image" alt="" />
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            var c = document.getElementById('auth-container');
            function go(register) {
                c.classList.toggle('sign-up-mode', register);
                document.title = (register ? 'Register' : 'Login') + ' - Fun in Action';
                history.replaceState(null, '', register ? c.dataset.registerUrl : c.dataset.loginUrl);
            }
            document.getElementById('sign-up-btn').addEventListener('click', function (e) { e.preventDefault(); go(true); });
            document.getElementById('sign-in-btn').addEventListener('click', function (e) { e.preventDefault(); go(false); });
        })();
    </script>
</body>
</html>