<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_row="@integer/material_motion_duration_long_1"
    android:background="@drawable/bbbackground"
    tools:menu="@menu/menu">

    <TextView
        android:id="@+id/tvDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="232dp"
        android:layout_marginBottom="694dp"
        android:fontFamily="@font/josefin_sans_bold"
        android:text="DASHBOARD"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.458" />

    <View
        android:id="@+id/vwProfile"
        android:layout_width="236dp"
        android:layout_height="49dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="159dp"
        android:layout_marginBottom="632dp"
        android:background="#266554"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vwBalances"
        android:layout_width="367dp"
        android:layout_height="64dp"
        android:layout_marginStart="19dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="547dp"
        android:background="#4DC9A9"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vwExpenses"
        android:layout_width="373dp"
        android:layout_height="199dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="199dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="333dp"
        android:background="#4DC9A9"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vwBudget"
        android:layout_width="374dp"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="404dp"
        android:layout_marginEnd="21dp"
        android:layout_marginBottom="147dp"
        android:background="#4DC9A9"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vwWallet"
        android:layout_width="94dp"
        android:layout_height="54dp"
        android:layout_marginStart="295dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="636dp"
        android:background="#266554"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnAddCategory"
        android:layout_width="166dp"
        android:layout_height="57dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="590dp"
        android:layout_marginEnd="106dp"
        android:layout_marginBottom="90dp"
        android:backgroundTint="#4DC9A9"
        android:fontFamily="@font/josefin_sans_bold"
        android:text="View Goals"
        android:textSize="20sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navBar"
        android:layout_width="412dp"
        android:layout_height="83dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="1dp"
        android:layout_marginTop="647dp"
        android:layout_marginBottom="1dp"
        android:background="@null"
        android:clickable="true"
        android:fontFamily="@font/josefin_sans_bold"
        app:backgroundTint="#4DC9A9"
        app:flow_horizontalAlign="center"
        app:horizontalItemTextAppearanceActive="@style/Base.Theme.BetterBudget_POE"
        app:itemActiveIndicatorStyle="@style/TextAppearance.Compat.Notification"
        app:itemBackground="#4DC9A9"
        app:itemGravity="center"
        app:itemHorizontalTranslationEnabled="true"
        app:itemIconSize="30dp"
        app:itemIconTint="@color/black"
        app:itemTextColor="#FFFFFF"
        app:labelFontScalingEnabled="true"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu" />

</androidx.constraintlayout.widget.ConstraintLayout>