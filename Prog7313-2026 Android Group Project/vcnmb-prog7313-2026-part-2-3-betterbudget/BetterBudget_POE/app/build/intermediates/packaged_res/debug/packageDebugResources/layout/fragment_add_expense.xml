<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bbbackground">

    <!-- TOP CIRCLE -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"

        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"/>

    <!-- BOTTOM CIRCLE -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_circle_bottom"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-80dp"
        android:layout_marginStart="-80dp"/>

    <!-- CONTENT -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="ADD EXPENSE"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- EXPENSE TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Expense Title:"
            android:textColor="#CCCCCC" />

        <EditText
            android:id="@+id/edtTitle"
            android:background="@drawable/input_bg"
            android:textColor="#FFFFFF"
            android:hint="e.g. Groceries"
            android:hintTextColor="#DDDDDD"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp" />

        <!-- AMOUNT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Amount:"
            android:textColor="#CCCCCC" />

        <EditText
            android:id="@+id/edtAmount"
            android:background="@drawable/input_bg"
            android:textColor="#FFFFFF"
            android:hint="$ e.g. 500"
            android:hintTextColor="#DDDDDD"
            android:padding="12dp"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp" />

        <!-- CATEGORY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Category:"
            android:textColor="#CCCCCC" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp" />

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#4DC9A9"
            android:text="Save Expense"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>