<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bbbackground">

    <!-- TOP CIRCLE -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"/>

    <!-- BOTTOM CIRCLE -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_circle_bottom"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-80dp"
        android:layout_marginStart="-80dp"/>

    <!-- CONTENT -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="CATEGORIES"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- BUTTONS -->
        <Button
            android:id="@+id/btnAddCategory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#4DC9A9"
            android:text="Add Category"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAddExpense"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4DC9A9"
            android:text="Add Expense"
            android:textColor="#FFFFFF" />

        <!-- COLOR PICKER -->
        <TextView
            android:text="Choose colour:"
            android:textColor="#CCCCCC"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/color1"
                style="@style/ColorCircle"
                android:background="#00BCD4"/>
            <View
                android:id="@+id/color2"
                style="@style/ColorCircle"
                android:background="#66CDAA"/>
            <View
                android:id="@+id/color3"
                style="@style/ColorCircle"
                android:background="#7E57C2"/>
            <View
                android:id="@+id/color4"
                style="@style/ColorCircle"
                android:background="#AB47BC"/>
            <View
                android:id="@+id/color5"
                style="@style/ColorCircle"
                android:background="#FFC107"/>
        </LinearLayout>

        <!-- CATEGORY LIST -->
        <TextView
            android:text="Categories"
            android:textColor="#CCCCCC"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategories"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"/>

        <!-- EXPENSE LIST -->
        <TextView
            android:text="Expenses"
            android:textColor="#CCCCCC"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerExpenses"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</FrameLayout>