<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:fontFamily="@font/josefin_sans_bold"
        android:text="EXPENSES"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SEARCH -->
    <EditText
        android:id="@+id/edtSearch"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="#FFFFFF"
        android:fontFamily="@font/josefin_sans"
        android:hint="SEARCH"
        android:inputType="text"
        app:layout_constraintEnd_toStartOf="@id/btnAddCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDashboard" />

    <!-- SEARCH BUTTON -->
    <Button
        android:id="@+id/btnAddCategory"
        android:layout_width="73dp"
        android:layout_height="46dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#4DC9A9"
        android:gravity="center_horizontal|center_vertical"
        android:includeFontPadding="false"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:isScrollContainer="false"
        app:icon="@drawable/ic_search"
        app:iconPadding="55dp"
        app:iconSize="25dp"
        app:layout_constraintBottom_toBottomOf="@id/edtSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/edtSearch" />

    <!-- ADD EXPENSE BUTTON  -->


    <androidx.cardview.widget.CardView
        android:id="@+id/signupPanel"
        android:layout_width="377dp"
        android:layout_height="521dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="126dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:background="#CC000000"
        android:backgroundTint="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:background="@android:color/transparent"
            android:fillViewport="false"
            android:scrollbarStyle="insideOverlay"
            android:verticalScrollbarPosition="right">

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/entryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#50CCAB"
        android:src="@android:drawable/ic_menu_add"
        app:backgroundTint="#50CCAB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.021"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.87" />

    <!-- SCROLL LIST INSIDE PANEL AREA -->

</androidx.constraintlayout.widget.ConstraintLayout>