<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".EditExpenseFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="16dp"
        android:layout_margin="10dp"
        android:gravity="center_horizontal">

        <!-- TITLE -->
        <TextView
            android:id="@+id/txtAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/josefin_sans_bold"
            android:text="EDIT EXPENSE"
            android:textColor="#EFEAEA"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- AMOUNT -->
        <EditText
            android:id="@+id/tdAmount"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:fontFamily="@font/josefin_sans"
            android:hint="Amount"
            android:inputType="numberDecimal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- DATE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textColor="#EFEAEA"
            android:textSize="14sp"
            android:paddingBottom="4dp" />

        <FrameLayout
            android:layout_width="376dp"
            android:layout_height="64dp"
            android:layout_marginBottom="10dp"
            android:background="@color/white"
            android:clipChildren="true">

            <DatePicker
                android:id="@+id/tdDate"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_gravity="top|center_horizontal"
                android:calendarViewShown="false"
                android:datePickerMode="spinner" />
        </FrameLayout>

        <!-- START TIME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textColor="#EFEAEA"
            android:fontFamily="@font/josefin_sans"
            android:textSize="13sp"
            android:layout_marginBottom="2dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="8dp"
            android:background="@color/white"
            android:clipChildren="true"
            android:clipToPadding="true">

            <TimePicker
                android:id="@+id/tdStartTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:timePickerMode="spinner" />
        </FrameLayout>

        <!-- END TIME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textColor="#EFEAEA"
            android:fontFamily="@font/josefin_sans"
            android:textSize="13sp"
            android:layout_marginBottom="2dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="8dp"
            android:background="@color/white"
            android:clipChildren="true"
            android:clipToPadding="true">

            <TimePicker
                android:id="@+id/tdEndTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:timePickerMode="spinner" />
        </FrameLayout>

        <!-- CATEGORY -->
        <Spinner
            android:id="@+id/tdCategory"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- DESCRIPTION -->
        <EditText
            android:id="@+id/tdDescription"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:fontFamily="@font/josefin_sans"
            android:hint="Description"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- IMAGE PREVIEW -->
        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@android:drawable/ic_menu_gallery"
            android:scaleType="centerCrop" />

        <!-- ADD IMAGE -->
        <Button
            android:id="@+id/btnAddImage"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#4DC9A9"
            android:fontFamily="@font/josefin_sans_bold"
            android:text="Add Image" />

        <!-- SAVE -->
        <Button
            android:id="@+id/btnSaveExpence"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#4DC9A9"
            android:fontFamily="@font/josefin_sans_bold"
            android:text="Save Expense"
            android:textColor="#FFFFFF" />

        <!-- CANCEL -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="#4DC9A9"
            android:fontFamily="@font/josefin_sans_bold"
            android:text="Cancel" />

    </LinearLayout>

</ScrollView>
