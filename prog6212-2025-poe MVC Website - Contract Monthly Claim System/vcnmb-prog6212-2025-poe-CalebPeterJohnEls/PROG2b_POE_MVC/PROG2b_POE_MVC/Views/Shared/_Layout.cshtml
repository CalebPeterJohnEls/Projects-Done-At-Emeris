<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMCS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PROG2b_POE_MVC.styles.css" asp-append-version="true" />
</head>
@*CSS styleing*@
<style>
    a.navbar-brand[b-qun1zumt63] {
    white-space: normal;
   background-color: palegreen;
    text-align: center;
    word-break: break-all;


}
ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
        background-color: palegreen;
}

li {
    float: left;
}

    li a {
        display: block;
        color: white;
        text-align: center;
        padding: 14px 16px;
        text-decoration: none;
    }

        li a:hover:not(.active) {
                background-color: lightgreen;
        }

    body {
        background-color: darkcyan;
      
        color: white;
        align-content: center;
    }

    h1 {
        font-family: Arial;
        color: #fff;
    }

    a, a:visited {
        color: limegreen
        text-decoration: underline;
    }

        a:hover {
            color: lightgreen;
            background-color: transparent;
            text-decoration: underline;
        }

    table, td, tr {
        border: 2px solid;
        border-color: aliceblue;
        background-color: palegreen;
    }

        table th {
            background: #007bff;
            color: white;
            
            text-transform: uppercase;
           
        }
    .header[b-qun1zumt63]
    {
        background-color: darkcyan;
    }

</style>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light  border-bottom box-shadow mb-3" style="background-color: palegreen">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CMCS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!--## Users for accessing pages
                    - HR:
                      Username: Johnny
                      Passsword: 2003
                    - Lecturer:
                      Username: CalebL
                      Passsword: 2003
                    - Coordinator:
                      Username: GigiC
                      Passsword: 2003
                    - Manager:
                      Username: JolyneM
                      Passsword: 2003-->
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            /*Calls Role from sessions in Account controller and declares it as a variable*/
                            var role = Context.Session.GetString("Role");
                        }
                      
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <!--Allows user to access specific pages based on their role -->
                        @if (role == "Lecturer")
                        {
                            <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Claims" asp-action="Index">Claims</a>
                        </li> 
                        }

                        @if (role == "Coordinator")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Coordinator" asp-action="Index">Coordinator</a>
                            </li>
                        }
                        
                        @if (role == "Manager")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Manager" asp-action="Index">Manager</a>
                            </li>
                        }
                        
                        @if (role == "HR")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="HR" asp-action="Index">HR</a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <!--When user is logged in, it will allow them to log out-->
                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("Username")))
                        {
                            <li class="nav-item">

								<p><center><span class="navbar-text text-dark">Hello, @Context.Session.GetString("Username")!</span></center></p>
                                <p>  </p>

                            </li>
                            <li class="nav-item">

                                <form asp-controller="Account" asp-action="Logout" method="post">

                                    <button type="submit" class="nav-link btn btn-link text-dark" style="background-color: palegreen ; color:darkcyan ">Logout</button>

                                </form>

                            </li>

                        }
                        else

                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - PROG2b_POE_MVC - 
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
