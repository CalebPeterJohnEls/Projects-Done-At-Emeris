@model PROG2b_POE_MVC.Models.HR

@{
    ViewData["Title"] = "Index";
}

<h1>HR Portal</h1>
<hr />

<h3>Submitted Claims</h3>
<hr />
<!--Shows all cliams-->
<table class="table table-bordered">
    <thead class="table-secondary">
        <tr>
            <th style="background-color: cadetblue">ID</th>
            <th style="background-color: cadetblue">User</th>
            <th style="background-color: cadetblue">Start Date</th>
            <th style="background-color: cadetblue">End Date</th>
            <th style="background-color: cadetblue">Total Hours</th>
            <th style="background-color: cadetblue">Total Amount</th>
            <th style="background-color: cadetblue">Submitted Date</th>
            <th style="background-color: cadetblue">Document</th>
            <th style="background-color: cadetblue">Status</th>
            <th style="background-color: cadetblue">Verified</th>
            <th style="background-color: cadetblue">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Claims)
        {
            <tr>
                <td>@item.Claim_ID</td>
                <td>@item.User</td>
                <td>@item.Start_Date.ToShortDateString()</td>
                <td>@item.End_Date.ToShortDateString()</td>
                <td>@item.Total_Hours</td>
                <td>@item.Total_Amount</td>
                <td>@item.Timestamp</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.DocumentPath))
                    {
                        <a href="@Url.Action("OpenFile", "Claims", new { fileName = item.DocumentPath })" target="_blank">
                            View Document
                        </a>
                    }
                </td>

                <td>@item.Status</td>
                <td>@item.Verified</td>

                <td>
                   
					<form asp-action="DeleteClaim" method="post" style="display:inline;">
						<input type="hidden" name="id" value="@item.Claim_ID" />
						<button type="submit" class="btn btn-danger btn-sm">Delete</button>
					</form>
				</td>
            </tr>
        }
    </tbody>
</table>
<!--Creates report-->
<a class="btn btn-primary" style="background-color: palegreen ; color:darkcyan " asp-action="GenerateReport">
    Download Approved Claims Report (PDF)
</a>
<hr />
<!--Shows all registered users-->
<h3>Registered Users</h3>
<hr />
<p>
    <a asp-action="RegisterUser" class="btn btn-secondary" style="background-color: palegreen ; color:darkcyan ">Register User</a>
    <!--Create button that send the user to the create new page-->
</p>
<table class="table table-bordered mt-4">
    <thead class="table-secondary">
        <tr>
            <th style="background-color: cadetblue">Username</th>
            <th style="background-color: cadetblue">Email</th>
            <th style="background-color: cadetblue">Role</th>
                 <th style="background-color: cadetblue">Hourly Rate</th>
            <th style="background-color: cadetblue">Date Created</th>
            <th style="background-color: cadetblue">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>@user.HourlyRate</td>
                <td>@user.DateCreated</td>

                <td>
                    <!--Edit user information-->
                    <a asp-action="EditUser" asp-route-username="@user.Username" class="btn btn-primary btn-sm">
                        Edit
                    </a>
                    <!--Delete user information-->
                    <form asp-action="DeleteUser" method="post" style="display:inline;">
                        <input type="hidden" name="username" value="@user.Username" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>

            </tr>
        }
    </tbody>
</table>
