@model PROG2b_POE_MVC.Models.Claims

@{
    ViewData["Title"] = "Create";
}

<h1>Add Claim</h1>
<hr />
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <h4 class="text-center mb-4">Submit a New Claim</h4>
            <hr />
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="p-4 border rounded shadow"
                  style="background-color: palegreen;">
             
                <div class="mb-3">
                    <label class="form-label" style="color: darkcyan;">Upload Supporting Document</label>
                    <input asp-for="Document" type="file" class="form-control" />
                    <span asp-validation-for="Document" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: darkcyan;">User</label>

                    <input type="text" class="form-control" value="@Model.User" readonly />
                    <input type="hidden" asp-for="User" />
                </div>
                <!--Name and surname is hidden-->
                <input type="hidden" asp-for="Name" />
                <input type="hidden" asp-for="Surname" />
                <div class="mb-3">
                    <label class="form-label" style="color: darkcyan;">Start Date</label>
                    <input asp-for="Start_Date" type="date" class="form-control" id="startDate" />
                    <span asp-validation-for="Start_Date" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: darkcyan;">End Date</label>
                    <input asp-for="End_Date" type="date" class="form-control" id="endDate" />
                    <span asp-validation-for="End_Date" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" style="color: darkcyan;">Total Hours</label>
                    <input asp-for="Total_Hours" type="number" class="form-control" />
                    <span asp-validation-for="Total_Hours" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: darkcyan;">Hourly Rate</label>
                    <input type="text" class="form-control" value="@Model.Hourly_Rate" readonly />
                    <input type="hidden" asp-for="Hourly_Rate" />
                </div>

                <div class="mb-4">
                    <label class="form-label" style="color: darkcyan;">Comments</label>
                    <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100" style="background-color: darkcyan;">Submit Claim</button>

                <p></p>
                <a asp-action="Index" class="btn btn-secondary w-100" style="background-color: darkcyan; color: palegreen;">Cancel</a>
            </form>
        </div>
    </div>
</div>
