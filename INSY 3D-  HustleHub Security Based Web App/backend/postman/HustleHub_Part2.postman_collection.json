            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"free_{{runId}}\",\n  \"email\": \"free_{{runId}}@example.com\",\n  \"password\": \"Password1\",\n  \"role\": \"freelancer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
