          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 429', () => pm.response.to.have.status(429));",
              "const j = pm.response.json();",
              "pm.test('Meaningful message', () => pm.expect(j.message).to.include('Too many'));",
              "pm.test('Tells the user when to retry', () => pm.expect(j.retryAfterSeconds).to.be.a('number').that.is.above(0));"
            ]
          }
        }
